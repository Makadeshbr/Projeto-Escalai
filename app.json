{
  "expo": {
    "name": "EscalaiApp",
    "slug": "EscalaiApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13151f"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aether.escalai",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#13151f"
      },
      "navigationBarColor": "#13151f",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f9e006",
          "defaultChannel": "default",
          "sounds": []
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "56abb260-3ac0-4ff7-8a82-9b30adc80d0f"
      }
    },
    "owner": "allanfsouza"
  }
}
